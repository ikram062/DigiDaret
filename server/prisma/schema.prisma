generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// The language the AI assistant explains the circle's rules in.
enum Language {
  DARIJA
  ARABIC
  FRENCH
  ENGLISH
}

// Identity is checked by the licensed partner's own KYC, never by us.
// Until a partner is connected every account starts UNVERIFIED.
enum KycStatus {
  UNVERIFIED
  PENDING
  VERIFIED
}

model User {
  id                String    @id @default(uuid())
  fullName          String
  email             String    @unique
  phone             String?   @unique
  passwordHash      String
  preferredLanguage Language  @default(ENGLISH)
  kycStatus         KycStatus @default(UNVERIFIED)
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  @@map("users")
}
