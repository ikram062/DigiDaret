generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------- Enums ----------

enum CredentialFormat {
  JSONLD
  SD_JWT
  MDOC
}

enum FlowMode {
  CROSS_DEVICE   // QR code
  SAME_DEVICE    // deep link / Digital Credentials API
}

enum TamperType {
  NONE
  WRONG_TYPE
  EXPIRED
  BAD_SIGNATURE
}

// What the verifier said about the credential
enum VerificationResult {
  VALID
  INVALID
  EXPIRED
  ERROR      // verifier crashed or never answered
  NOT_RUN    // run failed before reaching verification
}

// Did the TEST pass (not the credential)
enum RunOutcome {
  PENDING
  PASS
  FAIL
}

enum Phase {
  ISSUANCE       // OpenID4VCI
  PRESENTATION   // OpenID4VP
  VERIFICATION
}

enum EventDirection {
  REQUEST
  RESPONSE
}

// ---------- Models ----------

model TestRun {
  id         String   @id @default(uuid())
  createdAt  DateTime @default(now())
  finishedAt DateTime?
  durationMs Int?

  // Which implementations were picked (3-column selector)
  issuer   String   // "inji-certify" | "mock-issuer" | ...
  wallet   String   // "inji-web" | "inji-wallet-mobile" | "mock-wallet" | ...
  verifier String   // "inji-verify" | "mock-verifier" | ...

  // What was tested
  format    CredentialFormat
  proofType String?          // "Ed25519Signature2020" | "RsaSignature2018" | "ES256" ...
  flowMode  FlowMode         @default(CROSS_DEVICE)
  tamper    TamperType       @default(NONE)

  // Versions for regression tracking, e.g. {"inji-certify":"0.12.0","inji-verify":"0.14.0"}
  moduleVersions Json?

  // Results
  verificationResult VerificationResult @default(NOT_RUN)
  expectedResult     VerificationResult @default(VALID)  // for tamper runs: INVALID or EXPIRED
  outcome            RunOutcome         @default(PENDING)
  failedStep         String?            // stepName where it broke
  errorDetail        String?

  // Snapshot of what was issued (mock data only; redact real secrets)
  credentialSnapshot Json?
  notes              String?

  // Replay & tamper: a tampered run points to the original
  parentRunId String?
  parentRun   TestRun?  @relation("RunReplays", fields: [parentRunId], references: [id], onDelete: SetNull)
  replays     TestRun[] @relation("RunReplays")

  events RunEvent[]

  @@index([createdAt])
  @@index([format, outcome])
  @@index([issuer, wallet, verifier])
  @@map("test_runs")
}

model RunEvent {
  id        String   @id @default(uuid())
  runId     String
  run       TestRun  @relation(fields: [runId], references: [id], onDelete: Cascade)

  stepOrder Int
  phase     Phase
  stepName  String          // credential_offer, token, credential_request, auth_request, vp_token, verify_result...
  direction EventDirection
  fromActor String?         // "issuer" | "wallet" | "verifier" | "playground"
  toActor   String?

  // HTTP details, for the inspector
  httpMethod String?
  url        String?
  statusCode Int?
  headers    Json?          // redacted
  payload    Json           // raw body, redacted

  latencyMs Int?
  isError   Boolean  @default(false)
  createdAt DateTime @default(now())

  @@unique([runId, stepOrder])
  @@index([runId, phase])
  @@map("run_events")
}